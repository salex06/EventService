{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/event/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ms_object_service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/event/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" }
    },
    {
      "DownstreamPathTemplate": "/api/ticket/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ms_object_service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/ticket/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" }
    },
    {
      "DownstreamPathTemplate": "/api/user/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ms_client_service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/user/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" }
    },
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth_service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [ "POST" ]
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "TransformByOcelotConfig": false,
      "Config": [
        {
          "Name": "Auth Service API",
          "Version": "v1",
          "Url": "http://auth_service:8080/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "events",
      "TransformByOcelotConfig": false,
      "Config": [
        {
          "Name": "Events & Tickets API",
          "Version": "v1",
          "Url": "http://ms_object_service:8080/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "users",
      "TransformByOcelotConfig": false,
      "Config": [
        {
          "Name": "Users API",
          "Version": "v1",
          "Url": "http://ms_client_service:8080/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5001"
  }
}

